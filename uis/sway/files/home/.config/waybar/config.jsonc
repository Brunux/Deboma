{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "disk",
        "network",
        "battery"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "sway/mode": {
        "format": "<span font_desc='JetBrains Mono 13'>󰌌</span>  {}",
        "tooltip": false
    },
    "cpu": {
        "interval": 3,
        "format": "<span font_desc='JetBrains Mono 13'></span>  {usage}%",
        "tooltip-format": "CPU usage: {usage}%\nLoad: {load1} / {load5} / {load15}"
    },
    "memory": {
        "interval": 5,
        "format": "<span font_desc='JetBrains Mono 13'>󰍛</span>  {percentage}%",
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB"
    },
    "temperature": {
        "interval": 5,
        "critical-threshold": 80,
        "format": "<span font_desc='JetBrains Mono 13'></span>  {temperatureC}°C",
        "format-critical": "<span font_desc='JetBrains Mono 13'></span>  {temperatureC}°C",
        "tooltip": true
    },
    "disk": {
        "interval": 30,
        "path": "/",
        "format": "<span font_desc='JetBrains Mono 13'></span>  {percentage_used}%",
        "tooltip-format": "Root filesystem\nUsed: {used} / {total}\nFree: {free}"
    },
    "network": {
        "interval": 10,
        "format-wifi": "<span font_desc='JetBrains Mono 13'></span>  {signalStrength}%",
        "format-ethernet": "<span font_desc='JetBrains Mono 13'>󰈀</span>  Ethernet",
        "format-linked": "<span font_desc='JetBrains Mono 13'>󰈀</span>  {ifname}",
        "format-disconnected": "<span font_desc='JetBrains Mono 13'>󰖪</span>  Offline",
        "tooltip-format-wifi": "{essid}\n{ifname}: {ipaddr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}\nGateway: {gwaddr}"
    },
    "battery": {
        "bat": "sbs-8-000b",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span font_desc='JetBrains Mono 13'>{icon}</span>  {capacity}%",
        "format-charging": "<span font_desc='JetBrains Mono 13'></span>  {capacity}%",
        "format-plugged": "<span font_desc='JetBrains Mono 13'></span>  {capacity}%",
        "format-full": "<span font_desc='JetBrains Mono 13'></span>  {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "Remaining: {timeTo}",
        "interval": 30
    },
    "clock": {
        "format": "<span font_desc='JetBrains Mono 13'></span>  {:%d %b %H:%M}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 30
    }
}
