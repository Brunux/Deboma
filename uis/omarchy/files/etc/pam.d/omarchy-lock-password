#%PAM-1.0
#
# Authentication for the Omarchy shell's lock screen.
#
# Quickshell runs PAM for the lock under this service name (`PamContext {
# config: "omarchy-lock-password" }` in the shell's lock plugin), and the plugin
# refuses to lock at all while the file is missing: `omarchy-shell lock lock`
# answers `missing-pam`, `omarchy system lock` says "no lock screen is
# configured", and the suspend path (omarchy-system-sleep-lock) reports that the
# machine is going to sleep with the session exposed. Upstream writes this file
# from the install step `omarchy-apply-lock`, which is part of the Arch-only
# install family this port does not run, so the port ships it instead.
#
# Upstream's version is written for Arch and does not carry over:
#
#   * it ends with `account include system-local-login`, a stack name only Arch
#     has (Debian's equivalent is common-account);
#   * it stacks pam_faillock itself, which needs the tally directory
#     /var/run/faillock to exist — nothing creates it on Debian, and a
#     pam_faillock that cannot open its tally makes the lock screen reject the
#     correct password;
#   * it loads pam_systemd_home.so, which Debian does not ship (no systemd-homed).
#
# So this is Debian's own stack instead: the same one login(1), su(1), sshd and
# greetd authenticate against. What unlocks the lock screen is exactly what logs
# in at the greeter, and any password policy added to the distribution's stack
# (including rate limiting) applies to the lock screen as well.
#
# Keep this file identical in spirit to /etc/pam.d/greetd-greeter. Do not add
# pam_faillock here unless something also creates its tally directory (a
# tmpfiles.d entry for /run/faillock).
auth	include	common-auth
account	include	common-account
