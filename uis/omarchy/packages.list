# Omarchy v4 desktop (Hyprland + the Quickshell shell), ported from
# omacom/omarchy @ da2db1a2 (quattro, 4.0.0.alpha) to Debian forky/arm64.
# One package per line; blank lines and lines starting with # are ignored.
# Files shipped alongside this list live in uis/omarchy/files/.
#
# The Arch -> Debian mapping and every deliberate deviation are documented in
# uis/omarchy/README.md and docs/plan-omarchy.md §4. Packages already supplied by
# packages/base.list (network-manager, wireless-regdb, alsa-utils, rtkit,
# dosfstools, bash-completion, less) are not repeated here.

# --- compositor, session, portals ------------------------------------------
# Hyprland 0.56 reads its configuration from hyprland.lua; v3's hyprland.conf is
# deprecated. The pinned tree already ships the Lua configuration.
hyprland
hyprland-protocols
hyprland-backgrounds
# Qt GUI helpers (hyprland-guiutils upstream): the preview/share picker and the
# config editors.
hyprland-qtutils
# The session manager Omarchy starts Hyprland through, so the compositor runs as
# a systemd user session unit.
uwsm
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
# Hyprland enables its built-in Xwayland by default (xwayland:enabled = true),
# so X11-only programs (emulators, Wine, some Java/Steam games) need the server
# binary; nothing else pulls it in.
xwayland
hyprpicker
hyprsunset

# --- the shell -------------------------------------------------------------
# Omarchy v4's desktop shell is QML, not waybar/mako/walker: bar, launcher,
# notifications, OSD, lock screen and the menus all live in shell/.
quickshell
# Quickshell's Qt6 runtime. Debian splits the Arch qt6-* names into libraries
# plus qml6-module-*; these are the modules the pinned shell imports.
libqt6qml6
libqt6quick6
libqt6multimedia6
libqt6svg6
qt6-wayland
qt6-svg-plugins
qt6-image-formats-plugins
qt6-qpa-plugins
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qml6-module-qtquick-templates
qml6-module-qtquick-effects
qml6-module-qtquick-shapes
qml6-module-qtquick-dialogs
qml6-module-qtquick-particles
qml6-module-qtquick-localstorage
qml6-module-qt5compat-graphicaleffects
qml6-module-qtqml
qml6-module-qtqml-workerscript
qml6-module-qtcore
qml6-module-qtnetwork
qml6-module-qt-labs-platform
qml6-module-qt-labs-folderlistmodel
qml6-module-qt-labs-settings
qml6-module-qt-labs-qmlmodels
# A calculator widget in the shell uses Qalculate.
libqalculate23

# --- login -----------------------------------------------------------------
# The port keeps the Debian side's greetd + tuigreet instead of upstream's SDDM;
# the session entry is what picks Hyprland. See docs/plan-omarchy.md §2.
greetd
tuigreet

# --- keyboard --------------------------------------------------------------
# The Chromebook's top row is mapped to action keys by the device tree and never
# emits F1-F10, so there is no way to switch virtual terminals without a
# remapper; see uis/omarchy/files/etc/keyd/default.conf and the README.
keyd

# --- audio -----------------------------------------------------------------
pipewire
pipewire-pulse
# ALSA-only programs (aplay/arecord without -D, emulators, some Java/Steam
# games) fail with "audio open error: No such file or directory" without it.
pipewire-alsa
wireplumber
# The UCM profiles carry the MT8192 boot sequence; alsa-utils (base.list) runs
# it and alsa-ucm-conf provides the card definitions.
alsa-ucm-conf
# PipeWire's BlueZ SPA plugins, and the bluez daemon they talk to over D-Bus.
libspa-0.2-bluetooth
bluez
pavucontrol
# pamixer drives the XF86Audio* key bindings.
pamixer
# pactl: the shipped omarchy-capture-screenrecording and
# omarchy-audio-input-set-default call it, and check-system.sh reads the card
# with it. It comes from pulseaudio-utils, not from pipewire-pulse.
pulseaudio-utils

# --- power / battery -------------------------------------------------------
upower
power-profiles-daemon
# zram swap; Omarchy ships zram-generator on aarch64 and this port already has
# zram-tools in base.list.
systemd-zram-generator
playerctl

# --- network / bluetooth UI ------------------------------------------------
# Debian renamed network-manager-gnome to network-manager-applet.
network-manager-applet
blueman

# --- graphics (panfrost) ---------------------------------------------------
libgl1-mesa-dri
mesa-utils

# --- fonts / icons ---------------------------------------------------------
fonts-dejavu-core
fonts-noto-core
fonts-noto-cjk
fonts-noto-color-emoji
# The theme's text font; the icon glyphs come from fontconfig fallback.
fonts-jetbrains-mono
fonts-nerd-symbols
# fonts-nerd-symbols is DFSG-stripped: no Font Awesome (U+F000-U+F2FF) and no
# Material Design Icons (plane 15), which is what the theme's icons are. These
# two legacy sets supply them, so every glyph resolves without touching config.
fonts-font-awesome
fonts-materialdesignicons-legacy
yaru-theme-icon

# --- terminals -------------------------------------------------------------
foot
alacritty
kitty

# --- desktop integration ---------------------------------------------------
# gtk-launch is how the shell's AppLibrary (the launcher menu and the dock)
# starts a .desktop entry: without it, selecting any app does nothing. It ships
# in libgtk-3-bin, not in the GTK runtime libraries.
libgtk-3-bin
# Setup-time tools: setup.sh installs Omarchy's application entries and icons
# and then refreshes the desktop and icon caches with these.
desktop-file-utils
gtk-update-icon-cache

# --- desktop applications --------------------------------------------------
# Chromium is Omarchy's browser; the rest are the base set that resolves on
# Debian (see docs/plan-omarchy.md §4 for what is substituted or dropped).
chromium
nautilus
python3-nautilus
gnome-disk-utility
gnome-sushi
# Debian's document viewer is papers (evince's successor).
papers
imv
mpv
mpv-mpris
ffmpeg
ffmpegthumbnailer
imagemagick
neovim
gvfs-backends
udiskie
libsecret-1-0
gnome-keyring

# --- CLI / tooling ---------------------------------------------------------
# The shell's weather widget and several omarchy-* helpers fetch with curl;
# Debian's base does not include it, so the weather panel logs "binary could not
# be found" until it is installed.
curl
# The theme renderer (omarchy-theme-set-templates) keeps each template line's
# terminator in awk's RT, which only gawk sets. Debian's default awk is mawk, so
# without gawk every generated theme file collapses into a single line and foot
# rejects its own config ("section declaration contains trailing characters",
# the first omarchy boot). gawk's update-alternatives entry has the higher
# priority, so installing it also repoints /usr/bin/awk.
gawk
btop
fastfetch
eza
# Arch's `bat`; Debian's package installs the binary as `batcat`, and setup.sh
# adds /usr/local/bin/bat so the aliases and MANPAGER that call `bat` work.
bat
fd-find
ripgrep
fzf
lazygit
jq
tmux
zoxide
# The Omarchy prompt is starship's: default/bash/init initialises it when the
# binary is present, and without it the prompt stays Debian's.
starship
# notify-send: the terminal helpers report through it (omarchy-notification-send
# is what omarchy-transcode and the capture helpers call). The shell's own
# notifications are QML and do not need it.
libnotify-bin
# lua: the keybindings view (omarchy-menu-keybindings) scans the Lua bindings
# with it; without it the view silently shows nothing.
lua5.4
gum
tree-sitter-cli
# Debian's tldr client.
tealdeer
yt-dlp
inxi
plocate
socat
inotify-tools
unzip
whois
qrencode
zbar-tools
tesseract-ocr
tesseract-ocr-eng
wl-clipboard
wtype
# The capture stack. Screenshots go through omasnap, which is what
# omarchy-capture-screenshot execs (built by scripts/build-omasnap.sh: Debian has
# no package for it); the frozen-region pickers that OCR, QR and the recorder use
# are grim + slurp + hyprpicker. wf-recorder is the video fallback where
# gpu-screen-recorder is not packaged, and swappy is Debian's annotator in place
# of satty (the pinned tree itself does not call it).
grim
slurp
swappy
wf-recorder
# omasnap's run-time libraries: the Qt6 Widgets stack (the QML modules above do
# not pull it in), Qt6 DBus and LayerShellQt. The Qt6 Wayland client comes with
# qt6-wayland.
libqt6widgets6
libqt6dbus6
liblayershellqtinterface6
brightnessctl

# --- screensaver -----------------------------------------------------------
# The idle screensaver paints Omarchy's logo with ttfx, the desktop's own Rust
# port of terminaltexteffects, which has no Debian package. Debian ships the
# upstream Python original under this name, and files/usr/local/bin/ttfx runs it
# under ttfx's own name (omarchy-screensaver finds and kills the effect with
# `pgrep/pkill -x ttfx`, so the process name has to stay ttfx).
python3-terminaltexteffects

# --- xdg / theme integration ------------------------------------------------
xdg-user-dirs
xdg-utils
xdg-terminal-exec
qt6ct
nwg-look
lxqt-qtplugin
# GObject introspection for the GTK4 and layer-shell pieces the shell's widgets
# and the desktop integrations use.
gir1.2-gtk-4.0
libgtk-layer-shell0
gir1.2-gtklayershell-0.1
